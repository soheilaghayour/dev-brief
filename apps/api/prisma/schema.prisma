generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Better Auth core models (generated by the Better Auth CLI; hand edits stop at @@map) ---
model User {
  id            String           @id
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false)
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sessions      Session[]
  accounts      Account[]
  saves         Save[]
  preferences   FeedPreference[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Content ---
enum SourceKind {
  hn
  devto
  rss
  github
}

model Source {
  id                  String         @id @default(cuid())
  slug                String         @unique
  kind                SourceKind
  name                String
  siteUrl             String
  feedUrl             String?
  enabled             Boolean        @default(true)
  baselinePercentile  Float?
  etag                String?
  lastModified        String?
  consecutiveFailures Int            @default(0)
  circuitOpenUntil    DateTime?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  items               SourceItem[]
  runs                IngestionRun[]
}

model Story {
  id                   String                   @id @default(cuid())
  canonicalUrl         String                   @unique
  url                  String
  domain               String
  title                String
  normalizedTitle      String
  excerpt              String?
  author               String?
  publishedAt          DateTime
  firstSeenAt          DateTime                 @default(now())
  readingTimeMinutes   Int?
  tags                 String[]
  taggerVersion        Int
  engagementPercentile Float                    @default(0)
  rankScore            Float                    @default(0)
  rankedAt             DateTime?
  // Generated column from the hand-edited migration; the default mirrors pg_get_expr's rendering so migrate sees no drift.
  searchVector         Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(excerpt, ''::text)), 'B'::\"char\"))"))
  items                SourceItem[]
  saves                Save[]
  summary              Summary?

  @@index([publishedAt(sort: Desc), id(sort: Desc)])
  @@index([rankScore(sort: Desc), id(sort: Desc)])
  @@index([normalizedTitle, publishedAt])
  @@index([tags], type: Gin)
  @@index([searchVector], type: Gin)
}

model SourceItem {
  id             String   @id @default(cuid())
  storyId        String
  story          Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sourceId       String
  source         Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalId     String
  url            String
  canonicalUrl   String
  discussionUrl  String?
  title          String
  author         String?
  publishedAt    DateTime
  points         Int?
  commentsCount  Int?
  reactionsCount Int?
  stars          Int?
  engagement     Int      @default(0)
  percentile     Float?
  sourceTags     String[]
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@unique([sourceId, externalId])
  @@index([storyId])
  @@index([sourceId, publishedAt(sort: Desc)])
  @@index([canonicalUrl])
}

enum IngestionStatus {
  running
  success
  partial
  failed
  skipped
}

model IngestionRun {
  id           String          @id @default(cuid())
  runId        String
  sourceId     String?
  source       Source?         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status       IngestionStatus
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  itemsFetched Int             @default(0)
  itemsCreated Int             @default(0)
  itemsUpdated Int             @default(0)
  durationMs   Int?
  error        String?

  @@index([runId])
  @@index([sourceId, startedAt(sort: Desc)])
  @@index([startedAt])
}

model Save {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId String
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Restrict)
  savedAt DateTime @default(now())

  @@id([userId, storyId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([storyId])
}

model TagDailyStat {
  day           DateTime @db.Date
  tag           String
  storyCount    Int
  engagementSum Int
  avgPercentile Float
  updatedAt     DateTime @updatedAt

  @@id([day, tag])
  @@index([tag, day])
}

// --- Phase 2: summaries, preferences, LLM ledger ---
enum SummaryTrigger {
  auto
  on_demand
}

model Summary {
  id              String         @id @default(cuid())
  storyId         String         @unique
  story           Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tldr            String[]
  consensus       Json?
  suggestedTags   String[]
  basedOnComments Int
  trigger         SummaryTrigger
  model           String
  promptVersion   Int
  inputTokens     Int
  outputTokens    Int
  costUsd         Decimal        @db.Decimal(10, 6)
  createdAt       DateTime       @default(now())
}

enum PreferenceKind {
  tag
  source
}

enum PreferenceMode {
  follow
  mute
}

model FeedPreference {
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      PreferenceKind
  value     String
  mode      PreferenceMode
  createdAt DateTime       @default(now())

  @@id([userId, kind, value])
}

enum LlmFeature {
  summary_auto
  summary_on_demand
  copilot
}

model LlmUsage {
  id           String     @id @default(cuid())
  day          DateTime   @db.Date
  feature      LlmFeature
  model        String
  status       String
  reservedUsd  Decimal    @db.Decimal(10, 6)
  costUsd      Decimal?   @db.Decimal(10, 6)
  inputTokens  Int?
  outputTokens Int?
  userId       String?
  refId        String?
  createdAt    DateTime   @default(now())

  @@index([day, feature])
}

model RateLimitCounter {
  key   String
  day   DateTime @db.Date
  count Int      @default(0)

  @@id([key, day])
}
