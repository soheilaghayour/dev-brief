{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -e ../../.env.example -- nest start --watch --exec \"node --watch-preserve-output --watch-path=../../packages/shared/dist\"",
    "build": "pnpm db:generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm db:generate",
    "db:generate": "dotenv -e ../../.env -e ../../.env.example -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -e ../../.env.example -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -e ../../.env.example -- prisma migrate deploy",
    "db:seed": "pnpm --filter @devbrief/shared build && dotenv -e ../../.env -e ../../.env.example -- prisma db seed",
    "db:seed:e2e": "pnpm --filter @devbrief/shared build && dotenv -e ../../.env -e ../../.env.example -- tsx prisma/seedE2e.ts",
    "ingest:once": "pnpm --filter @devbrief/shared build && nest build && dotenv -e ../../.env -e ../../.env.example -- node dist/cli/ingestOnce.js",
    "briefings:generate": "pnpm --filter @devbrief/shared build && nest build && dotenv -e ../../.env -e ../../.env.example -- node dist/cli/generateExampleBriefings.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.106",
    "@devbrief/shared": "workspace:*",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nestjs": "^10.78.0",
    "ai": "7.0.177",
    "better-auth": "1.7.26",
    "entities": "9.0.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "3.13.0",
    "rxjs": "^7.8.2",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.5.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "26",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0"
  }
}
