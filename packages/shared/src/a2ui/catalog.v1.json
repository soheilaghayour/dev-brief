{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devbrief.dev/a2ui/catalogs/devbrief/v1.json",
  "catalogId": "https://devbrief.dev/a2ui/catalogs/devbrief/v1.json",
  "protocolVersion": "1.0",
  "title": "DevBrief catalog",
  "description": "Briefing components for the DevBrief copilot.",
  "components": {
    "Briefing": {
      "type": "object",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "@path": {
                  "type": "string",
                  "pattern": "^\\/"
                }
              },
              "required": ["@path"],
              "additionalProperties": true
            }
          ]
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "@path": {
                  "type": "string",
                  "pattern": "^\\/"
                }
              },
              "required": ["@path"],
              "additionalProperties": true
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 12
        },
        "component": {
          "type": "string",
          "const": "Briefing"
        }
      },
      "required": ["title", "children", "component"],
      "additionalProperties": true,
      "allowedParents": ["Surface"]
    },
    "KeyTakeaways": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60,
          "default": "Key takeaways"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 200
              },
              "storyIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 3
              }
            },
            "required": ["text", "storyIds"],
            "additionalProperties": true
          },
          "minItems": 1,
          "maxItems": 5
        },
        "component": {
          "type": "string",
          "const": "KeyTakeaways"
        }
      },
      "required": ["items", "component"],
      "additionalProperties": true,
      "allowedParents": ["Briefing"]
    },
    "StoryClusterCard": {
      "type": "object",
      "properties": {
        "storyId": {
          "type": "string",
          "minLength": 1
        },
        "clusterId": {
          "type": ["string", "null"]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "domain": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["hn", "devto", "rss", "github"]
              },
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "points": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "comments": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reactions": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stars": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["kind", "label", "url", "points", "comments", "reactions", "stars"],
            "additionalProperties": true
          },
          "minItems": 1,
          "maxItems": 6
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "react",
              "vue",
              "typescript",
              "javascript",
              "ai-llms",
              "system-design",
              "databases",
              "devops",
              "security",
              "performance",
              "css",
              "rust",
              "go",
              "python",
              "testing",
              "web-platform",
              "mobile",
              "career"
            ]
          },
          "maxItems": 5
        },
        "tldr": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 220
          },
          "maxItems": 3
        },
        "note": {
          "type": "string",
          "maxLength": 160
        },
        "component": {
          "type": "string",
          "const": "StoryClusterCard"
        }
      },
      "required": [
        "storyId",
        "clusterId",
        "title",
        "url",
        "domain",
        "publishedAt",
        "sources",
        "tags",
        "component"
      ],
      "additionalProperties": true,
      "allowedParents": ["Briefing"]
    },
    "ConsensusCallout": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "maxLength": 80
        },
        "verdict": {
          "type": "string",
          "enum": ["mostly_positive", "mixed", "mostly_negative"]
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "point": {
                "type": "string",
                "maxLength": 180
              },
              "storyIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 3
              }
            },
            "required": ["point", "storyIds"],
            "additionalProperties": true
          },
          "maxItems": 4
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "point": {
                "type": "string",
                "maxLength": 180
              },
              "storyIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 3
              }
            },
            "required": ["point", "storyIds"],
            "additionalProperties": true
          },
          "maxItems": 4
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "maxItems": 3
        },
        "component": {
          "type": "string",
          "const": "ConsensusCallout"
        }
      },
      "required": ["topic", "verdict", "pros", "cons", "component"],
      "additionalProperties": true,
      "allowedParents": ["Briefing"]
    },
    "TechVelocityChart": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "window": {
          "type": "string",
          "enum": ["7d", "30d"]
        },
        "metric": {
          "type": "string",
          "enum": ["stories", "engagement"]
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string",
                "enum": [
                  "react",
                  "vue",
                  "typescript",
                  "javascript",
                  "ai-llms",
                  "system-design",
                  "databases",
                  "devops",
                  "security",
                  "performance",
                  "css",
                  "rust",
                  "go",
                  "python",
                  "testing",
                  "web-platform",
                  "mobile",
                  "career"
                ]
              },
              "label": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": ["date", "value"],
                  "additionalProperties": true
                },
                "maxItems": 31
              }
            },
            "required": ["tag", "label", "points"],
            "additionalProperties": true
          },
          "minItems": 1,
          "maxItems": 5
        },
        "component": {
          "type": "string",
          "const": "TechVelocityChart"
        }
      },
      "required": ["title", "window", "metric", "series", "component"],
      "additionalProperties": true,
      "allowedParents": ["Briefing"]
    },
    "TagBadgeList": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "enum": [
                  "react",
                  "vue",
                  "typescript",
                  "javascript",
                  "ai-llms",
                  "system-design",
                  "databases",
                  "devops",
                  "security",
                  "performance",
                  "css",
                  "rust",
                  "go",
                  "python",
                  "testing",
                  "web-platform",
                  "mobile",
                  "career"
                ]
              },
              "label": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              },
              "deltaPct": {
                "type": "number"
              }
            },
            "required": ["slug", "label"],
            "additionalProperties": true
          },
          "minItems": 1,
          "maxItems": 12
        },
        "component": {
          "type": "string",
          "const": "TagBadgeList"
        }
      },
      "required": ["tags", "component"],
      "additionalProperties": true,
      "allowedParents": ["Briefing"]
    }
  }
}
