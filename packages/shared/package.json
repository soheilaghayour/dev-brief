{
  "name": "@devbrief/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./a2ui/fixtures/*": "./src/a2ui/fixtures/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "catalog:generate": "tsx scripts/generateCatalog.ts && prettier --write src/a2ui/catalog.v1.json"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
