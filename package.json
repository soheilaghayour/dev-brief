{
  "name": "dev-brief",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @devbrief/shared build && concurrently -n web,api -c blue,green \"pnpm --filter web dev\" \"pnpm --filter api dev\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "test": "vitest run --coverage",
    "format:check": "prettier --check .",
    "smoke:prod": "playwright test -c e2e/playwright.prod.config.ts",
    "e2e": "dotenv -e .env -e .env.example -- playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
