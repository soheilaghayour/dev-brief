# Set by the tools (next dev, next build, CI); leave unset locally
# NODE_ENV=
# Public origin of the app (the proxy in production, the web dev server locally)
APP_URL=http://localhost:3000
# Where the web server reaches the API
API_INTERNAL_URL=http://localhost:3001
# Build-time target of Next's /api/* rewrite for `next dev` and the e2e build; leave unset in production builds
API_PROXY_URL=http://localhost:3001
# Shared secret the web server sends so its server-side API calls skip the per-IP rate limit (16+ characters)
INTERNAL_API_TOKEN=local-internal-token
# API listen port
PORT=3001
# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql://devbrief:devbrief@localhost:5432/devbrief
# Also run ingestion on boot when the last good run is older than 60 min
INGEST_ON_BOOT=false
# Register the cron jobs (hourly ingestion at :05 UTC, daily maintenance at 03:15 UTC) ('true' or 'false'); unset is on in production, off elsewhere. Off here: run `pnpm --filter api ingest:once` by hand
INGEST_SCHEDULE=false
# Release reported by /health (the deploy sets it, e.g. the git SHA); defaults to "dev"
# APP_VERSION=
# Integration tests truncate this database, so it is never the dev one
DATABASE_URL_TEST=postgresql://devbrief:devbrief@localhost:5432/devbrief_test
# Better Auth signing secret (32+ characters); generate one with `openssl rand -base64 32`
BETTER_AUTH_SECRET=local-dev-better-auth-secret-0123456789
# GitHub OAuth app (requests only user:email); callback ${APP_URL}/api/auth/callback/github (docs/operations.md)
GITHUB_CLIENT_ID=local-github-client-id
GITHUB_CLIENT_SECRET=local-github-client-secret
# Google OAuth client; callback ${APP_URL}/api/auth/callback/google (docs/operations.md)
GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret
# GitHub source: a fine-grained token with no extra permissions (public search only, not the OAuth app above); unset skips the source (docs/operations.md)
# GITHUB_TOKEN=
# Registers POST /api/auth/test/sign-in for Playwright; only allowed outside production on a loopback APP_URL
AUTH_TEST_MODE=false
# API phase flags ('true' or 'false'); off, a flagged route answers 404 FEATURE_DISABLED
FEATURE_SUMMARIES=false
FEATURE_PREFERENCES=false
FEATURE_CLUSTERS=false
# Summarise the top stories after each ingestion run ('true' or 'false'); needs FEATURE_SUMMARIES=true, makes live LLM calls
AUTO_SUMMARIES=false
# Cluster the new stories after each ingestion run ('true' or 'false'); needs FEATURE_CLUSTERS=true, makes live LLM calls
AUTO_CLUSTERING=false
# Secret behind the daily-rotating salt of the stored IP digests (32+ characters); required when FEATURE_SUMMARIES=true; generate one with `openssl rand -base64 32`
# IP_HASH_SECRET=
# Anthropic API key; required when FEATURE_SUMMARIES=true or FEATURE_CLUSTERS=true, unset in dev and CI (docs/operations.md)
# ANTHROPIC_API_KEY=
# Model the LLM service calls; its price must be in apps/api/src/modules/llm/budget.ts or set below
# LLM_MODEL=claude-haiku-5-5
# Daily LLM spend caps in USD; unset uses the defaults in apps/api/src/modules/llm/budget.ts (PRD §8.1)
# LLM_CAP_SUMMARY_AUTO_USD_DAY=
# LLM_CAP_SUMMARY_ON_DEMAND_USD_DAY=
# LLM_CAP_CLUSTER_USD_DAY=
# LLM_CAP_COPILOT_USD_DAY=
# LLM_CAP_GLOBAL_USD_DAY=
# USD per 1M input / output tokens of LLM_MODEL; unset uses the price table in budget.ts
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# Web phase flags, inlined at build time ('true' or 'false', unset is off); any other value fails the build
# NEXT_PUBLIC_FEATURE_SUMMARIES=
# NEXT_PUBLIC_FEATURE_PREFERENCES=
# NEXT_PUBLIC_FEATURE_CLUSTERS=
# Sentry project DSN for the API; unset turns error reporting off
# SENTRY_DSN=
# Sentry DSN for the web app, inlined at build time (also read by the web server); unset turns it off
# NEXT_PUBLIC_SENTRY_DSN=
# Release the web app reports to Sentry, inlined at build time (the web Dockerfile sets it from Coolify's SOURCE_COMMIT)
# NEXT_PUBLIC_APP_VERSION=
# Build-time only: source-map upload for the web build; all three unset skips the upload
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
